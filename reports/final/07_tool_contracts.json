          "time_unit",
          "claim_type",
          "performance_measure",
          "missing_sales"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "tool",
      "arguments"
    ],
    "additionalProperties": false
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_metric_definition",
        "description": "지표의 단위, 분기 기준, 산식, 출처, 지원 범위를 조회한다.",
        "parameters": {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "total_sales",
                "night_share_pct",
                "known_performance_count",
                "model_association"
              ]
            }
          },
          "required": [
            "metric"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "summarize_sales",
        "description": "선택한 자치구·업종·분기의 제공 매출 합계와 합계의 비율 방식 야간 비중을 조회한다.",
        "parameters": {
          "type": "object",
          "properties": {
            "district": {
              "type": "string",
              "enum": [
                "종로구",
                "마포구"
              ]
            },
            "industry": {
              "type": "string",
              "enum": [
                "한식음식점",
                "중식음식점",
                "일식음식점",
                "양식음식점",
                "제과점",
                "패스트푸드점",
                "치킨전문점",
                "분식전문점",
                "호프-간이주점",
                "커피-음료"
              ]
            },
            "quarter": {
              "type": "string",
              "enum": [
                "20231",
                "20232",
                "20233",
                "20234",
                "20241",
                "20242",
                "20243",
                "20244",
                "20251",
                "20252",
                "20253",
                "20254"
              ]
            }
          },
          "required": [
            "district",
            "industry",
            "quarter"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_model_result",
        "description": "저장된 특정 시나리오·결과변수·업종 코드의 기울기, 신뢰구간, p값과 표본 수를 조회한다.",
        "parameters": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "log_sales",
                "night_share_pct"
              ]
            },
            "scenario": {
              "type": "string",
              "enum": [
                "main_500",
                "radius_300",
                "radius_800",
                "balanced_500",
                "stores_500",
                "total_stores_500",
                "gee_within_between_500"
              ]
            },
            "industry_id": {
              "type": "string",
              "enum": [
                "CS100001",
                "CS100002",
                "CS100003",
                "CS100004",
                "CS100005",
                "CS100006",
                "CS100007",
                "CS100008",
                "CS100009",
                "CS100010"
              ]
            }
          },
          "required": [
            "outcome",
            "scenario",
            "industry_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_industry_omnibus",
        "description": "05의 업종별 기울기가 모두 같다는 귀무가설의 공동 F 검정과 Holm p값을 조회한다.",
        "parameters": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "log_sales",
                "night_share_pct"
              ]
            },
            "scenario": {
              "type": "string",
              "enum": [
                "main_500",
                "radius_300",
                "radius_800",
                "balanced_500",
                "stores_500",
                "total_stores_500"
              ]
            }
          },
          "required": [
            "outcome",
            "scenario"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_quality_summary",
        "description": "통과한 구조·모형 검증과 별도로 미해결 자료·해석 한계를 조회한다.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    }
  ]
}