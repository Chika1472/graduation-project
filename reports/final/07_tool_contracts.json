{
  "schema_version": "0.3-final-all10food",
  "status": "offline_callable_tools_only",
  "llm_connected": false,
  "web_service_built": false,
  "default_context": {
    "time_unit": "quarter",
    "claim_type": "association",
    "performance_measure": "registered_performance_ids",
    "missing_sales": "preserve_missing"
  },
  "industry_catalog": {
    "CS100001": "한식음식점",
    "CS100002": "중식음식점",
    "CS100003": "일식음식점",
    "CS100004": "양식음식점",
    "CS100005": "제과점",
    "CS100006": "패스트푸드점",
    "CS100007": "치킨전문점",
    "CS100008": "분식전문점",
    "CS100009": "호프-간이주점",
    "CS100010": "커피-음료"
  },
  "optional_gee_available": true,
  "request_envelope_schema": {
    "type": "object",
    "properties": {
      "tool": {
        "type": "string",
        "enum": [
          "get_metric_definition",
          "summarize_sales",
          "get_model_result",
          "get_industry_omnibus",
          "get_quality_summary"
        ]
      },
      "arguments": {
        "type": "object"
      },
      "request_context": {
        "type": "object",
        "properties": {
          "time_unit": {
            "type": "string",
            "enum": [
              "quarter",
              "daily"
            ]
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "association",
              "causal_effect"
            ]
          },
          "performance_measure": {
            "type": "string",
            "enum": [
              "registered_performance_ids",
              "show_runs"
